{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloatTranslate",
  "version": "1.1.1",
  "identifier": "com.weber5.floattranslate",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerHooks": "./installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FloatTranslate",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Weber-5/FloatTranslate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQkE3RURCREJBQTVDQkQKUldTOVhLcmIyMzY2N0xuWW54Z1RKeC9VMC9EQnI4WGEvRmNDbnExZ0o3YlhJbE4ycUxmSGMxV0sK"
    }
  }
}
